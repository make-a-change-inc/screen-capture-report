{
  "name": "screen-capture-report-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --check worker/index.js",
    "check": "node --check worker/index.js",
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create screen-capture-report-admin-db --binding DB --update-config",
    "db:migrate": "wrangler d1 execute DB --remote --file db/schema.sql"
  },
  "devDependencies": {
    "wrangler": "4.115.0"
  }
}
